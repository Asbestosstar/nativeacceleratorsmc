<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.asbestosstar</groupId>
    <artifactId>native-accelerator</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Native Accelerator</name>
    <description>Multi-loader Panama native acceleration layer for Minecraft</description>
    <url>https://github.com/Asbestosstar/nativeacceleratorsmc</url>

    <licenses>
        <license>
            <name>The Unlicense</name>
            <url>https://unlicense.org/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/Asbestosstar/nativeacceleratorsmc.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/Asbestosstar/nativeacceleratorsmc.git</developerConnection>
        <url>https://github.com/Asbestosstar/nativeacceleratorsmc</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

       

        <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
        <maven.jar.plugin.version>3.5.1</maven.jar.plugin.version>
        <exec.maven.plugin.version>3.5.0</exec.maven.plugin.version>
        <download.maven.plugin.version>1.13.0</download.maven.plugin.version>
        <install.maven.plugin.version>3.1.4</install.maven.plugin.version>
        <minecraft.version>26.3</minecraft.version>
        <minecraft.compatibility>&gt;=26.3</minecraft.compatibility>
        <mixin.config>nativeaccelerator.mixins.json</mixin.config>
        <native.build>false</native.build>
        <minecraft.client.url>https://piston-data.mojang.com/v1/objects/e877b6a07acd633fb3bb475002175cec036e7b87/client.jar</minecraft.client.url>
        <minecraft.client.jar>${project.build.directory}/minecraft/client.jar</minecraft.client.jar>
    </properties>

     <repositories>
        <repository>
            <id>MCForge</id>
            <name>MCForge</name>
            <url>https://maven.minecraftforge.net/</url>
        </repository>
        <repository>
            <id>Minecraft</id>
            <name>Minecraft</name>
            <url>https://libraries.minecraft.net</url>
        </repository>
        <repository>
            <id>TLauncher</id>
            <name>TLauncher</name>
            <url>https://res.tlauncher.org</url>
        </repository>
        <repository>
            <id>NeoForge</id>
            <name>NeoForge</name>
            <url>https://maven.neoforged.net/</url>
        </repository>


        <repository>
            <id>FabricMC</id>
            <name>FabricMC</name>
            <url>https://maven.fabricmc.net/</url>
        </repository>


        <repository>
            <id>jitpack</id>
            <name>jitpack</name>
            <url>https://jitpack.io/</url>
        </repository>


    </repositories>

    <dependencies>

        <!-- The client jar is downloaded from Mojang and installed by maven-install-plugin in the
             initialize phase. Declaring it as a provided dependency (rather than
             additionalClasspathElements, which maven-compiler-plugin 3.15.0 silently ignores) is what
             actually puts the named net.minecraft.* classes on the compile classpath for Mixins.
             provided: the classes ship with the game at runtime, so they must never be bundled. -->
        <dependency>
            <groupId>net.minecraft</groupId>
            <artifactId>minecraft</artifactId>
            <version>${minecraft.version}</version>
            <classifier>client</classifier>
            <scope>provided</scope>
        </dependency>

        <!-- https://mvnrepository.com/artifact/net.minecraftforge/eventbus -->
        <dependency>
            <groupId>net.minecraftforge</groupId>
            <artifactId>eventbus</artifactId>
            <version>6.2.6</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.14.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.14.0</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>net.minecraftforge</groupId>
            <artifactId>modlauncher</artifactId>
            <version>10.2.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.minecraftforge</groupId>
            <artifactId>fmlcore</artifactId>
            <version>1.20.6-50.0.4</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.minecraftforge</groupId>
            <artifactId>javafmllanguage</artifactId>
            <version>1.20.6-50.0.4</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.minecraftforge</groupId>
            <artifactId>lowcodelanguage</artifactId>
            <version>1.20.6-50.0.4</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.minecraftforge</groupId>
            <artifactId>mclanguage</artifactId>
            <version>1.20.6-50.0.4</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.minecraftforge</groupId>
            <artifactId>fmlloader</artifactId>
            <version>1.20.6-50.0.4</version>
            <scope>provided</scope>
        </dependency>

        <!-- https://mvnrepository.com/artifact/cpw.mods/securejarhandler -->
        <dependency>
            <groupId>cpw.mods</groupId>
            <artifactId>securejarhandler</artifactId>
            <version>1.0.1</version>
            <scope>provided</scope>
        </dependency>


        <!-- https://mvnrepository.com/artifact/cpw.mods/securejarhandler -->
        <dependency>
            <groupId>cpw.mods</groupId>
            <artifactId>modlauncher</artifactId>
            <version>10.1.10</version>
            <scope>provided</scope>
        </dependency>


        <!-- https://mvnrepository.com/artifact/net.fabricmc/fabric-loader -->
        <dependency>
            <groupId>net.fabricmc</groupId>
            <artifactId>fabric-loader</artifactId>
            <version>0.17.3</version>
            <scope>provided</scope>
        </dependency>


        <dependency>
            <groupId>net.neoforged.fancymodloader</groupId>
            <artifactId>loader</artifactId>
            <version>10.0.14</version>
            <scope>provided</scope>
        </dependency>


        <!-- https://mvnrepository.com/artifact/net.fabricmc/sponge-mixin -->
        <dependency>
            <groupId>net.fabricmc</groupId>
            <artifactId>sponge-mixin</artifactId>
            <version>0.16.5+mixin.0.8.7</version>
            <scope>provided</scope>
        </dependency>





        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>datafixerupper</artifactId>
            <version>7.0.14</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- End of Do not include these in fat jar -->


        <dependency>
            <groupId>com.asbestosstar</groupId>
            <artifactId>featurecreep-loader</artifactId>
            <version>6.0.0-am3</version>
        </dependency>


      



        <dependency>
            <groupId>com.asbestosstar</groupId>
            <artifactId>comoraclestream-dax-stub</artifactId>
            <version>0.0.1</version>
        </dependency>




        <!-- Minecraft supplies JOML at runtime; declare it for fast model-decoder compilation. -->
        <dependency>
            <groupId>org.joml</groupId>
            <artifactId>joml</artifactId>
            <version>1.10.8</version>
            <scope>provided</scope>
        </dependency>

<!-- Add these inside your existing <dependencies> element. -->
<dependency>
    <groupId>org.lwjgl</groupId>
    <artifactId>lwjgl-spvc</artifactId>
    <version>3.4.3</version>
</dependency>
<dependency>
    <groupId>org.jspecify</groupId>
    <artifactId>jspecify</artifactId>
    <version>1.0.0</version>
</dependency>


<dependency>
    <groupId>org.lwjgl</groupId>
    <artifactId>lwjgl-sdl</artifactId>
    <version>3.4.3</version>
</dependency>






        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>brigadier</artifactId>
            <version>1.3.10</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <includes>
                    <include>LICENSE</include>
                </includes>
                <targetPath>META-INF</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>${download.maven.plugin.version}</version>
                <executions>
                    <execution>
                        <id>download-minecraft-client</id>
                        <phase>initialize</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <url>${minecraft.client.url}</url>
                            <outputDirectory>${project.build.directory}/minecraft</outputDirectory>
                            <outputFileName>client.jar</outputFileName>
                            <overwrite>false</overwrite>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>${install.maven.plugin.version}</version>
                <executions>
                    <execution>
                        <id>install-minecraft-client</id>
                        <phase>initialize</phase>
                        <goals><goal>install-file</goal></goals>
                        <configuration>
                            <file>${minecraft.client.jar}</file>
                            <groupId>net.minecraft</groupId>
                            <artifactId>minecraft</artifactId>
                            <version>${minecraft.version}</version>
                            <classifier>client</classifier>
                            <packaging>jar</packaging>
                            <generatePom>true</generatePom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>25</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven.jar.plugin.version}</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <MixinConfigs>${mixin.config}</MixinConfigs>
                            <Implementation-Title>Native Accelerator</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Implementation-URL>https://github.com/Asbestosstar/nativeacceleratorsmc</Implementation-URL>
                            <FMLModType>MOD</FMLModType>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native.build</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec.maven.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>build-native-library</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>sh</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/build-native.sh</argument>
                                        <argument>${project.build.directory}</argument>
                                        <argument>${project.build.outputDirectory}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
